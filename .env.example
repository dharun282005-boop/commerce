# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Databases (docker compose defaults). Leave empty to run without them.
DATABASE_URL=postgres://cuc:cuc_dev_password@localhost:5432/cuc
REDIS_URL=redis://localhost:6379

# Data policy: fixture-only mode (owner decision 2026-10-28)
KILL_SWITCH_ALL=false
# Comma-separated source ids to switch off, e.g. fixture-zomato
DISABLED_SOURCES=
# Comma-separated source ids to switch on even if disabled by default (real sources need owner approval)
ENABLED_SOURCES=ondc-mock
# Tier-3 data folder (CSV/JSON). Default: data/imports
IMPORT_DIR=
# Owner-only admin endpoints (imports). Long random string; leave empty to disable admin endpoints.
ADMIN_TOKEN=
# ONDC: mock gateway served by the API itself in development. Enable the source with ENABLED_SOURCES=ondc-mock
ONDC_MOCK=true
ONDC_GATEWAY_URL=
# Dev only: simulate failures, e.g. fixture-zomato:timeout,fixture-croma:error
FIXTURE_FAIL=

# Agent (Phase E). The model id is read from env, never hard-coded.
# Leave the key empty to use the offline planner (no API calls, no cost).
ANTHROPIC_API_KEY=
# e.g. claude-opus-5-5 (only used when a key is set)
ANTHROPIC_MODEL=
# low | medium | high
AGENT_EFFORT=medium
