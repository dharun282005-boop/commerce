# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Databases (docker compose defaults). Leave empty to run without them.
DATABASE_URL=postgres://cuc:cuc_dev_password@localhost:5432/cuc
REDIS_URL=redis://localhost:6379

# Data policy: fixture-only mode (owner decision 2026-10-28)
KILL_SWITCH_ALL=false
# Comma-separated source ids to switch off, e.g. fixture-zomato
DISABLED_SOURCES=
# Comma-separated source ids to switch on even if disabled by default (real sources need owner approval)
ENABLED_SOURCES=
# Dev only: simulate failures, e.g. fixture-zomato:timeout,fixture-croma:error
FIXTURE_FAIL=

# Agent (Phase E). The model id is read from env, never hard-coded.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
