{
  "name": "chennai-universal-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @cuc/api",
    "db:migrate": "npm run migrate -w @cuc/db",
    "db:seed": "npm run seed -w @cuc/db",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "ci": "npm run lint && npm run typecheck && npm test",
    "eval": "tsx apps/api/eval/run.ts",
    "dev:web": "npm run dev -w @cuc/web",
    "e2e": "npm run e2e -w @cuc/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
